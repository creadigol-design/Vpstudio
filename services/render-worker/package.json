{
  "name": "@virtual-studio/render-worker",
  "version": "0.1.0",
  "description": "Render worker: assembles takes into branded landscape and vertical drafts with FFmpeg",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
